# Desktop MCP Bridge v1.0 example environment.
DMB_TRANSPORT=stdio
DMB_HOST=127.0.0.1
DMB_PORT=8765
DMB_ACTION_HOST=127.0.0.1
DMB_ACTION_PORT=8766
DMB_ACTION_API_KEY=
DMB_ACCESS_PROFILE=safe
DMB_APPROVAL_POLICY=guarded
DMB_ALLOWED_ROOTS=["C:/Users/YOUR_NAME/Desktop/AI-Workspace"]
DMB_ENABLE_DESKTOP_CONTROL=true
DMB_ENABLE_SHELL=true
DMB_ENABLE_OCR=true
DMB_ENABLE_BROWSER=true
DMB_BROWSER_HEADLESS=false
DMB_TESSDATA_DIR=C:/Users/YOUR_NAME/AppData/Local/DesktopMCPBridge/tessdata
DMB_COMMAND_TIMEOUT_SECONDS=120
DMB_ARTIFACT_TTL_SECONDS=300
DMB_IDEMPOTENCY_TTL_SECONDS=900
# Full profile additionally requires:
# DMB_ACCESS_PROFILE=full
# DMB_FULL_ACCESS_CONFIRMATION=I UNDERSTAND THIS GRANTS FULL CONTROL
