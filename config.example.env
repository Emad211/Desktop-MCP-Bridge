# Transport used by the MCP server.
DMB_TRANSPORT=stdio
DMB_HOST=127.0.0.1
DMB_PORT=8765

# GPT Action Gateway. Generate a long random token; never commit the real value.
DMB_ACTION_HOST=127.0.0.1
DMB_ACTION_PORT=8766
DMB_ACTION_API_KEY=replace-with-at-least-32-random-characters

# safe | developer | full
DMB_ACCESS_PROFILE=safe
DMB_ALLOWED_ROOTS=["D:/AI-Workspace"]

# Full mode requires this exact second opt-in.
# DMB_ACCESS_PROFILE=full
# DMB_FULL_ACCESS_CONFIRMATION=I UNDERSTAND THIS GRANTS FULL CONTROL

DMB_ENABLE_DESKTOP_CONTROL=true
DMB_ENABLE_SHELL=true
DMB_ENABLE_WINDOW_CONTROL=true
DMB_ENABLE_UI_AUTOMATION=true
DMB_ENABLE_DELETE=false
DMB_ENABLE_RECURSIVE_DELETE=false
DMB_ENABLE_PROCESS_CONTROL=false
DMB_ENABLE_CLIPBOARD=false
DMB_ENABLE_REGISTRY=false
DMB_ENABLE_SERVICE_CONTROL=false
DMB_ENABLE_PACKAGE_MANAGEMENT=false
DMB_ENABLE_NETWORK_ADMIN=false
DMB_ENABLE_SCHEDULED_TASKS=false
DMB_ENABLE_POWER_CONTROL=false

DMB_COMMAND_TIMEOUT_SECONDS=120
DMB_MAX_READ_BYTES=10000000
DMB_MAX_WRITE_BYTES=10000000
DMB_COMMAND_OUTPUT_BYTES=500000
