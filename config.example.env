# Copy values into environment variables or edit scripts/run.ps1.
# Nested lists are easiest to provide as JSON environment values.

DMB_TRANSPORT=stdio
DMB_HOST=127.0.0.1
DMB_PORT=8765
DMB_ALLOWED_ROOTS=["C:/Users/YOUR_NAME/Desktop/AI-Workspace"]
DMB_ENABLE_DESKTOP_CONTROL=true
DMB_ENABLE_SHELL=true
DMB_ENABLE_PROCESS_CONTROL=false
DMB_ENABLE_DELETE=false
DMB_ALLOW_POWERSHELL=true
DMB_COMMAND_TIMEOUT_SECONDS=120
